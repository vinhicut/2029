# =========================================================================
# TỬ VI HỒNG ÂN - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Hướng dẫn bảo mật:
# 1. Sao chép tệp này thành '.env' trên máy chủ hoặc môi trường phát triển:
#    cp .env.example .env (Linux/macOS) hoặc Copy-Item .env.example .env (Windows)
# 2. Điền các giá trị thực tế (API Keys, Client Secrets, Firebase credentials).
# 3. Tuyệt đối KHÔNG commit tệp '.env' lên GitHub hoặc chia sẻ công khai.
# =========================================================================

# --- Frontend (Vite) Configuration ---
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_API_URL=/api

# --- Backend Server & Security Configuration ---
HOST=0.0.0.0
PORT=2026
# Cổng host Docker Compose: 2028 -> container 2026.
APP_PORT=2028
CORS_ORIGIN=*
SECRET_KEY=your_production_secret_key_here
DATABASE_MODE=modular # 'modular' (10 CSDL chuyên biệt Domain-Driven Design) hoặc 'monolithic' (tuvi.db)

# --- Google OAuth Credentials (Backend) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional: comma-separated additional authorized web client IDs.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# --- Firebase Service Account Credentials ---
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Authorization & Roles ---
MANAGER_EMAILS=admin@tuvihongan.com,quanly@tuvihongan.com
SUPER_ADMIN_EMAILS=owner@tuvihongan.com

# --- Booking notification email (SMTP) ---
BOOKING_NOTIFICATION_EMAIL=nguyenvinhvan90@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_gmail@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM_EMAIL=your_sending_gmail@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Google Gemini AI API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-4-argon
THINKING_LEVEL=MEDIUM
MOCK_LLM_SERVICE=false
MAX_OUTPUT_TOKENS=26000
EXTENDED_MAX_OUTPUT_TOKENS=26000
EXTENDED_REQUEST_TIMEOUT_MS=900000
QA_MODEL_NAME=gemini-3.8-flash
QA_THINKING_LEVEL=LOW
QA_MAX_OUTPUT_TOKENS=10000
TARGET_OPTIMAL_WORDS=6500
TARGET_MIN_WORDS=5800
TARGET_MAX_WORDS=7200
MAX_WORDS_LIMIT=8500
MAX_CHARS_LIMIT=38000
AI_REQUEST_TIMEOUT_MS=600000

# --- SePay & Bank Transfer Configuration ---
SEPAY_API_KEY=your_sepay_webhook_api_key
SEPAY_BANK_NAME=MB
SEPAY_ACCOUNT_NO=8857159999
SEPAY_ACCOUNT_NAME=TU VI HONG AN
